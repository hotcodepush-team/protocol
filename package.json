{
  "name": "@hotcodepush/protocol",
  "description": "The HotCodePush update-protocol client for JavaScript: the wire types, the evaluator and the fixture suite",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "homepage": "https://hotcodepush.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotcodepush-team/protocol-js.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expo-updates": {
      "types": "./dist/expo-updates/index.d.ts",
      "default": "./dist/expo-updates/index.js"
    },
    "./fingerprint": {
      "types": "./dist/fingerprint/index.d.ts",
      "default": "./dist/fingerprint/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "fmt": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "pkg-pr-new": "0.0.88",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@yarnpkg/parsers": "3.1.0",
    "mime": "4.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
